{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements Traceability",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "requirement",
      "source_evidence",
      "research_influence",
      "acceptance_tests",
      "gaps_or_risks"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{3}$"
      },
      "requirement": {
        "type": "string",
        "minLength": 12
      },
      "source_evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 3
        }
      },
      "research_influence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 3
        }
      },
      "acceptance_tests": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 3
        }
      },
      "gaps_or_risks": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
